# Copy to .env and fill in as needed. The system runs with none of these set
# (falls back to MockLLM + default CRM profile).

# OpenAI API key. Leave unset to use MockLLM (no cost, no network).
OPENAI_API_KEY=

# Cheapest suitable OpenAI model at time of writing. Check pricing before
# changing: https://openai.com/api/pricing/
WA_OPENAI_MODEL=gpt-4o-mini

# Max output tokens for the one LLM call per run.
WA_LLM_MAX_OUTPUT_TOKENS=400

# LLM temperature (0 = deterministic).
WA_LLM_TEMPERATURE=0

# SQLite file for checkpoints, long-term memory, and LLM cache.
WA_DB_PATH=data/wealth_advisor.db

# Directory holding mock client JSON files.
WA_CLIENTS_DIR=data/clients

# Directory holding the mock CRM records file.
WA_CRM_DIR=data/crm

# Simulate CRM failures for testing error handling (0.0 - 1.0).
WA_CRM_FAILURE_RATE=0.0

# Log level and log file.
WA_LOG_LEVEL=INFO
WA_LOG_FILE=logs/run.jsonl
